  SetEnv TERM=xterm-256color

Host griecoserver
  Hostname 10.13.13.2
  Port 22
  User alex
  IdentityFile ~/.ssh/homelab_ed25519

Host griecoserver-root
  Hostname 10.13.13.2
  Port 22
  User root
  IdentityFile ~/.ssh/homelab_ed25519

Host traefik
  Hostname 10.2.0.3
  User alex
  IdentityFile ~/.ssh/github_ed25519

Host homelab-home
  Hostname 10.2.0.2
