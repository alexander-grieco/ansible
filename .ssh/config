  IdentityFile ~/.ssh/homelab_ed25519
  #Port 49382

Host ticktick
  Hostname 10.13.13.19
  User alex
  IdentityFile ~/.ssh/homelab_ed25519

Host github.com
  User alexander-grieco
  Hostname github.com
